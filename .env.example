# Base URL of the EECMI backend API (Express + MongoDB).
# Defaults to the deployed Render service when unset.
# For local development against a machine on your network, use your LAN IP:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:5000
EXPO_PUBLIC_API_URL=https://eecmi-platform.onrender.com

# Clerk publishable key (safe to expose — it is a public key).
# Same value as the website's REACT_APP_CLERK_PUBLISHABLE_KEY.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_cmVuZXdpbmctZ29vc2UtMC5jbGVyay5hY2NvdW50cy5kZXYk
